{:secrets   #or [#include ".secrets.edn"
                 #include #join [#env HOME "/.secrets.edn"]
                 {}]

 :database  {:dbtype   "postgresql"
             :host     #profile {:dev  "localhost"
                                 :test "localhost"
                                 :prod #or [#env DB_HOST "localhost"]}
             :user     #profile {:dev  "app_user"
                                 :test "app_user"
                                 :prod #or [#env DB_USER "app_user"]}
             :password #profile
                        {:dev  #or [#env DB_DEV_PASSWORD
                                    #ref [:secrets :db :dev-password]]
                         :test #or [#env DB_TEST_PASSWORD
                                    #ref [:secrets :db :test-password]]
                         :prod #env DB_PASSWORD}
            ;; Profile-specific settings
             :port     #profile {:dev  55432
                                 :test 55433
                                 :prod #or [#env DB_PORT 5432]}
             :dbname   #profile {:dev  "multi_tenant_pos"
                                 :test "multi_tenant_pos_test"
                                 :prod #or [#env DB_NAME "multi_tenant_pos"]}
             :jdbc-url #profile
                        {:dev  #join ["jdbc:postgresql://localhost:55432/multi_tenant_pos?user=app_user&password="
                                      #or [#env DB_DEV_PASSWORD #ref [:secrets :db :dev-password]]]
                         :test #join ["jdbc:postgresql://localhost:55433/multi_tenant_pos_test?user=app_user&password="
                                      #or [#env DB_TEST_PASSWORD #ref [:secrets :db :test-password]]]
                         ;; In prod, prefer DATABASE_URL env var (see core.clj);
                         ;; this is a fallback if DATABASE_URL is not set.
                         :prod #env DATABASE_URL}}

 ;; HikariCP Connection Pool Configuration
 :hikari-cp {:maximum-pool-size        20
             :minimum-idle             5
             :connection-timeout       30000
             :idle-timeout             600000
             :max-lifetime             1800000
             :validation-timeout       5000
             :leak-detection-threshold 60000
             :register-mbeans          true}

 ;; Metrics Configuration
 :metrics   {:hikari     true
             :database   true
             :prometheus {:enabled true
                          :port    9190}}

 :webserver {:host #profile {:dev  "localhost"
                             :test "localhost"
                             :prod #or [#env HOST "0.0.0.0"]}
             :port #profile {:dev  8085
                             :test 8086
                             :prod #or [#env PORT 8080]}}

 ;; Public base URL for links in emails, OAuth callbacks, etc.
 ;; In production set BASE_URL=https://your-app.railway.app (no trailing slash).
 :base-url #profile {:dev  nil
                     :test nil
                     :prod #or [#env BASE_URL nil]}

 :cache     {:size 1000
             :ttl  3600}

 ;; OAuth Configuration (optional)
 :oauth     {:google {:client-id         #or [#env GOOGLE_OAUTH_CLIENT_ID
                                              #ref [:secrets :oauth :google :client-id]]
                      :client-secret     #or [#env GOOGLE_OAUTH_CLIENT_SECRET
                                              #ref [:secrets :oauth :google :client-secret]]
                      :scopes            ["email" "profile" "openid"]
                      :authorize-uri     "https://accounts.google.com/o/oauth2/auth"
                      :access-token-uri  "https://oauth2.googleapis.com/token"
                      :user-info-uri     "https://www.googleapis.com/oauth2/v3/userinfo"
                      :redirect-uri      #profile {:dev  "http://localhost:8085/oauth/google/callback"
                                                   :test "http://localhost:8086/oauth/google/callback"
                                                   :prod #env GOOGLE_OAUTH_REDIRECT_URI}
                      :launch-uri        "/login/google"
                      :landing-uri       "/"
                      :basic-auth?       false}
             :github {:client-id         #or [#env GITHUB_OAUTH_CLIENT_ID
                                              #ref [:secrets :oauth :github :client-id]]
                      :client-secret     #or [#env GITHUB_OAUTH_CLIENT_SECRET
                                              #ref [:secrets :oauth :github :client-secret]]
                      :scopes            ["user:email"]
                      :authorize-uri     "https://github.com/login/oauth/authorize"
                      :access-token-uri  "https://github.com/login/oauth/access_token"
                      :user-info-uri     "https://api.github.com/user"
                      :redirect-uri      #profile {:dev  "http://localhost:8085/oauth2/github/callback"
                                                   :test "http://localhost:8086/oauth2/github/callback"
                                                   :prod #env GITHUB_OAUTH_REDIRECT_URI}
                      :launch-uri        "/oauth2/github"
                      :landing-uri       "/"
                      :basic-auth?       false}}

 ;; Stripe Configuration (optional for template)
 :stripe    {:api-key                 #profile
                                       {:dev  #or [#env STRIPE_TEST_API_KEY
                                                   #ref [:secrets :stripe :test-api-key]]
                                        :test #or [#env STRIPE_TEST_API_KEY
                                                   #ref [:secrets :stripe :test-api-key]]
                                        :prod #or [#env STRIPE_LIVE_API_KEY
                                                   #ref [:secrets :stripe :live-api-key]]}
             :webhook-endpoint-secret #profile
                                       {:dev  #or [#env STRIPE_TEST_WEBHOOK_SECRET
                                                   #ref [:secrets :stripe :test-webhook-secret]]
                                        :test #or [#env STRIPE_TEST_WEBHOOK_SECRET
                                                   #ref [:secrets :stripe :test-webhook-secret]]
                                        :prod #or [#env STRIPE_LIVE_WEBHOOK_SECRET
                                                   #ref [:secrets :stripe :live-webhook-secret]]}
             :api-version             "2024-12-18"
             :max-network-retries     3
             :timeout                 80000
             :use-connection-pool?    true
             :pool-options            {:timeout           5
                                       :threads           4
                                       :default-per-route 2
                                       :insecure?         false}}

 ;; Email Configuration
;; - :dev / :test  → Gmail SMTP (SMTP works on local dev; test uses :in-memory)
;; - :prod         → Gmail REST API over HTTPS (Railway blocks SMTP ports 465/587)
;;
;; Required Railway env vars for prod:
;;   GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET  (same as OAuth login)
;;   GMAIL_REFRESH_TOKEN   — see docs/template/backend/gmail-api-setup.md
;;   SMTP_FROM_EMAIL       — the Gmail address you send from
 :email {:type #profile {:dev  :gmail-smtp
                         :test :gmail-smtp
                         :prod :gmail-api}
         :postmark {:api-key    #or [#env POSTMARK_API_KEY
                                     #ref [:secrets :postmark :api-key]]
                    :from-email #or [#env POSTMARK_FROM_EMAIL
                                     #ref [:secrets :postmark :from-email]]}
         ;; Gmail REST API credentials (prod only)
         :gmail-api {:client-id     #or [#env GOOGLE_OAUTH_CLIENT_ID
                                         #ref [:secrets :oauth :google :client-id]]
                     :client-secret #or [#env GOOGLE_OAUTH_CLIENT_SECRET
                                         #ref [:secrets :oauth :google :client-secret]]
                     :refresh-token #or [#env GMAIL_REFRESH_TOKEN
                                         #ref [:secrets :gmail :refresh-token]]}
         ;; Gmail SMTP (dev only — Railway blocks SMTP outbound)
         :smtp #profile {:dev  {:host #or [#env SMTP_HOST #ref [:secrets :gmail :smtp-host]]
                                :port #or [#ref [:secrets :gmail :smtp-port] 587]
                                :user #or [#env SMTP_USER #ref [:secrets :gmail :smtp-user]]
                                :pass #or [#env SMTP_PASS #ref [:secrets :gmail :smtp-pass]]
                                :tls  true}
                         :test {:transport :in-memory}
                         :prod {}}
         :from-email #profile {:dev  #or [#env SMTP_FROM_EMAIL
                                          #ref [:secrets :gmail :from-email]]
                               :test "test@example.com"
                               :prod #or [#env SMTP_FROM_EMAIL
                                          #ref [:secrets :gmail :from-email]]}}

 ;; Google Places API configuration (optional)
 ;; - Keep secrets (API keys) in config/.secrets.edn or env vars
 :places {:api-key       #or [#env GOOGLE_PLACES_API_KEY
                              #ref [:secrets :places :api-key]]
          :region-code   "BA"
          :language-code "bs"
          :timeout-ms    3000
          :max-results   5
          :currency-region-map {"BAM" "BA"
                                "EUR" "HR"
                                "USD" "US"}
          ;; Optional bias for short/ambiguous queries
          :location-bias {:circle {:lat      43.8563
                                   :lng      18.4131
                                   :radius-m 50000.0}}}

 ;; Serper.dev configuration (optional)
 :serper {:api-key    #or [#env SERPER_API_KEY
                           #ref [:secrets :serper :api-key]]
          :base-url   "https://google.serper.dev"
          :endpoint   "/search"
          :timeout-ms 4000
          :gl         "ba"
          :hl         "bs"}

 ;; Cerebras configuration (optional)
 ;; - Keep secrets (API keys) in env / config/.secrets.edn
 ;; - Receipt refinement is controlled per-user via the Expenses Settings toggle.
 ;; - The Cerebras integration is considered available when a Cerebras API key is present.
 :cerebras  {:base-url           "https://api.cerebras.ai/v1"
             :model              "qwen-3.8-27b"
             :refine-concurrency 5
             :refine-timeout-ms  60000
             ;; Prevent structured-output truncation (e.g. finish_reason=length)
             ;; by explicitly budgeting completion tokens for the refine step.
             :refine-max-tokens  32000
             :conn-timeout-ms    5000
             :socket-timeout-ms  60000}

 ;; LlamaParse OCR configuration (optional)
 ;; Tiers: "fast" (~5-15s), "cost_effective", "agentic" (~2-5min), "agentic_plus"
 ;; See also: LLAMAPARSE_TIER, LLAMAPARSE_POLL_TIMEOUT_MS env overrides.
 :llamaparse {:tier "agentic"}

 ;; Claude API (article resolver). Key: env ANTHROPIC_API_KEY or [:secrets :anthropic :api-key].
 ;; Keys that are not scoped to a workspace also need ANTHROPIC_WORKSPACE_ID (or :workspace-id here).
 :anthropic {:base-url          "https://api.anthropic.com"
             :model             "claude-sonnet-5-5"
             :effort            "medium"
             :max-tokens        16000
             :fallbacks?        true
             :conn-timeout-ms   5000
             :socket-timeout-ms 300000
             :max-retries       3
             :retry-sleep-ms    1000}

 ;; Background alias -> article resolver (dev only for now). :apply-mode :dry-run never mutates
 ;; the catalog; switch to :auto only after the evaluation gate (PLAN-auto-article-resolution.md, Phase 7).
 :article-resolver {:enabled?                 #profile {:dev true :test false :prod false}
                    :apply-mode               :auto
                    :interval-seconds         60
                    :lookback-hours           24
                    :claim-limit              200
                    :batch-size               50
                    ;; Wait for 50 pending rows or a 15-minute-old row before calling Claude (shares the prompt cost)
                    :settle-minutes           15
                    :auto-apply-threshold     70
                    :noise-threshold          90
                    :allow-new-subcategories? true
                    :allow-new-manufacturers? true
                    :excluded-categories      ["Subscriptions" "Utilities" "Ostalo"]
                    :stale-processing-seconds 600
                    :max-attempts             3
                    :candidate-limit          5
                    ;; Jev (TypeSafe) fills a category Claude left empty or invalid. Key: TYPESAFE_API_KEY. Off: the audit agent covers it.
                    ;; :mode :full also flags category disagreement / name mismatch (tested: no precision gain).
                    :verifier                 {:enabled? false :mode :fill-category}}

 ;; Tenant provisioning defaults
 ;; These are copied into each new tenant's lookup tables on creation.
 ;; Labels/names may be locale maps {:en "..." :bs "..."} — resolved via :default-locale.
 :default-locale :bs

 :tenant-defaults {:payers             [{:label {:en "Household" :bs "Kućanstvo"}}
                                        {:label {:en "Other"     :bs "Ostalo"}}]

                   :expense-categories [{:name {:en "Default"       :bs "Podrazumijevano"} :is-default true}
                                        {:name {:en "Groceries"     :bs "Namirnice"}}
                                        {:name {:en "Transport"     :bs "Prijevoz"}}
                                        {:name {:en "Utilities"     :bs "Komunalije"}}
                                        {:name {:en "Dining"        :bs "Restorani"}}
                                        {:name {:en "Healthcare"    :bs "Zdravlje"}}
                                        {:name {:en "Entertainment" :bs "Zabava"}}
                                        {:name {:en "Shopping"      :bs "Kupovina"}}
                                        {:name {:en "Other"         :bs "Ostalo"}}]}}
