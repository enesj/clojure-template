{
  "chat.instructionsFilesLocations": {
    ".github/copilot-instructions.md": true
  },
  "chat.mcp.serverSampling": {
    "clojure-template/.vscode/mcp.json: clojure-mcp": {
      "allowedModels": [
        "copilot/gpt-5.1-codex-max",
        "copilot/gpt-5.2"
      ]
    },
    "clojure-template/.vscode/mcp.json: chrome-devtools": {
      "allowedModels": [
        "copilot/gpt-5.1-codex-max",
        "copilot/gpt-5.2"
      ]
    }
  },
  "chat.tools.terminal.autoApprove": {
    "unzip": true,
    "/^echo \"META:\" && readlink /tmp/active_command\\.txt && echo \"---\" && cat /tmp/active_command\\.txt && echo \"---\" && source /tmp/active_command\\.txt 2>/dev/null \\|\\| true$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "diff": true
  },
  "editor.formatOnSave": true
}
