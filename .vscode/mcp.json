{
  "servers": {
    "clojure-mcp": {
      "type": "stdio",
      "command": "/bin/sh",
      "args": [
        "-c",
        "cd /Users/enes/Projects/clojure-mcp && PATH=/opt/homebrew/bin:$PATH && clojure -X:mcp-shadow-dual"
      ],
      "env": {
        "HOME": "/tmp"
      }
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ]
    },
    "postgres": {
      "type": "stdio",
      "command": "/bin/sh",
      "args": [
        "-c",
        "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; cd \"$repo_root\" && set -a; [ -f \"$repo_root/.postgres.env\" ] && . \"$repo_root/.postgres.env\"; set +a; exec /Users/enes/Projects/toolbox --prebuilt postgres --stdio"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
  }
}
