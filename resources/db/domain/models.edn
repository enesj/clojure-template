{;; ============================================================================
 ;; Home Expenses Tracker — Domain Database Schema
 ;; ============================================================================
 ;; This file defines all tables for the expense tracking domain.
 ;; Tables with tenant_id are tenant-scoped; others are global catalog.
 ;; ============================================================================

 ;; ----------------------------------------------------------------------------
 ;; Suppliers (stores, shops, vendors) — global catalog
 ;; ----------------------------------------------------------------------------

 :suppliers {:fields [[:id :uuid {:primary-key true}]
                      [:display_name [:varchar 255] {:null false}]
                      [:normalized_key [:varchar 255] {:null false}]
                      [:address :text]
                      [:created_at :timestamptz {:default [:now]}]
                      [:updated_at :timestamptz {:default [:now]}]]
             :indexes [[:idx_suppliers_normalized_key :btree {:fields [:normalized_key] :unique true}]]}

 ;; ----------------------------------------------------------------------------
 ;; Cities (canonical city names) — global catalog
 ;; ----------------------------------------------------------------------------

 :cities {:fields [[:id :uuid {:primary-key true}]
                   [:name [:varchar 255] {:null false}]
                   [:normalized_key [:varchar 255] {:null false}]
                   [:zip [:varchar 20]]
                   [:country [:varchar 255] {:foreign-key :countries/country :null false :default "Bosnia and Herzegovina" :on-delete :restrict :on-update :cascade}]
                   [:created_at :timestamptz {:default [:now]}]
                   [:updated_at :timestamptz {:default [:now]}]]
          :indexes [[:idx_cities_normalized_key :btree {:fields [:normalized_key] :unique true}]
                    [:uniq_cities_country_zip :btree {:fields [:country :zip] :unique true}]]}

 ;; ----------------------------------------------------------------------------
 ;; Countries (canonical country names) — global catalog
 ;; ----------------------------------------------------------------------------

 :countries {:fields [[:country [:varchar 255] {:primary-key true}]
                      [:code [:varchar 2] {:null false}]
                      [:created_at :timestamptz {:default [:now]}]
                      [:updated_at :timestamptz {:default [:now]}]]
             :indexes [[:idx_countries_code :btree {:fields [:code] :unique true}]]}

 ;; ----------------------------------------------------------------------------
 ;; Stores (locations/branches for a supplier) — global catalog
 ;; ----------------------------------------------------------------------------

 :stores {:fields [[:id :uuid {:primary-key true}]
                   [:supplier_id :uuid {:foreign-key :suppliers/id :null false :on-delete :cascade}]
                   [:display_name [:varchar 255] {:null false}]
                   [:normalized_key [:varchar 255] {:null false}]
                   [:address :text]
                   [:city_id :uuid {:foreign-key :cities/id :on-delete :set-null}]

                   [:created_at :timestamptz {:default [:now]}]
                   [:updated_at :timestamptz {:default [:now]}]]
          :indexes [[:idx_stores_supplier :btree {:fields [:supplier_id]}]
                    [:idx_stores_supplier_normalized_key
                     :btree
                     {:fields [:supplier_id :normalized_key] :unique true}]

                    [:idx_stores_city_id :btree {:fields [:city_id]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Store Aliases (deduplicated raw store/address guesses -> canonical stores) — global
 ;; ----------------------------------------------------------------------------

 :store_aliases {:fields [[:id :uuid {:primary-key true}]
                          ;; Representative latest-seen raw label text
                          [:raw_label :text]
                          ;; Canonical normalized key for dedupe
                          [:raw_label_normalized [:varchar 255] {:null false}]
                          ;; NULL = unmapped
                          [:store_id :uuid {:foreign-key :stores/id :on-delete :set-null}]
                          [:confidence :integer {:default 100}]
                          [:created_at :timestamptz {:default [:now]}]
                          [:updated_at :timestamptz {:default [:now]}]]
                 :indexes [[:idx_store_aliases_raw_label_normalized
                            :btree
                            {:fields [:raw_label_normalized] :unique true}]
                           [:idx_store_aliases_store_id
                            :btree
                            {:fields [:store_id]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Supplier Aliases (deduplicated raw supplier guesses -> canonical suppliers) — global
 ;; ----------------------------------------------------------------------------

 :supplier_aliases {:fields [[:id :uuid {:primary-key true}]
                             ;; Representative latest-seen raw label text
                             [:raw_label :text]
                             ;; Canonical normalized key for dedupe
                             [:raw_label_normalized [:varchar 255] {:null false}]
                             ;; NULL = unmapped
                             [:supplier_id :uuid {:foreign-key :suppliers/id :on-delete :set-null}]
                             [:confidence :integer {:default 100}]
                             [:created_at :timestamptz {:default [:now]}]
                             [:updated_at :timestamptz {:default [:now]}]]
                    :indexes [[:idx_supplier_aliases_raw_label_normalized
                               :btree
                               {:fields [:raw_label_normalized] :unique true}]
                              [:idx_supplier_aliases_supplier_id
                               :btree
                               {:fields [:supplier_id]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Dedup Ignored Clusters (admin-hidden false-positive duplicate clusters)
 ;; ----------------------------------------------------------------------------

 :dedup_ignored_clusters {:fields [[:id :uuid {:primary-key true}]
                                   [:admin_id :uuid {:foreign-key :admins/id
                                                     :null false
                                                     :on-delete :cascade}]
                                   [:entity_type [:varchar 32] {:null false}]
                                   [:cluster_id [:varchar 64] {:null false}]
                                   [:member_ids :jsonb {:null false}]
                                   [:note :text]
                                   [:created_at :timestamptz {:default [:now]}]]
                          :indexes [[:uniq_dedup_ignored_clusters_admin_entity_cluster
                                     :btree
                                     {:fields [:admin_id :entity_type :cluster_id]
                                      :unique true}]
                                    [:idx_dedup_ignored_clusters_admin_entity
                                     :btree
                                     {:fields [:admin_id :entity_type]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Payers (payment methods: cash, cards, accounts, people) — tenant-scoped
 ;; ----------------------------------------------------------------------------

 :payers {:fields [[:id :uuid {:primary-key true}]
                   [:tenant_id :uuid {:foreign-key :tenants/id :null false :on-delete :cascade}]
                   [:type [:enum :payer-type] {:null false :default "custom"}]
                   [:label [:varchar 255] {:null false}]

                   [:is_default :boolean {:default false}]
                   [:is_active :boolean {:null false :default true}]
                   [:created_at :timestamptz {:default [:now]}]
                   [:updated_at :timestamptz {:default [:now]}]]
          :types [[:payer-type :enum {:choices ["system" "custom"]}]]
          :indexes [[:idx_payers_tenant :btree {:fields [:tenant_id]}]
                    [:idx_payers_type :btree {:fields [:type]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Receipts (uploaded images, ADE processing status) — tenant-scoped
 ;; ----------------------------------------------------------------------------

 :receipts {:fields [[:id :uuid {:primary-key true}]
                     [:tenant_id :uuid {:foreign-key :tenants/id :null false :on-delete :cascade}]

                     [:subject_ref [:varchar 64]]
                     [:created_by_subject_ref [:varchar 64]]
                     [:payer_id :uuid {:foreign-key :payers/id :on-delete :set-null}]
                     [:expense_category_id :uuid {:foreign-key :expense_categories/id :on-delete :set-null}]
                     [:notes :text]
                     [:storage_key :text {:null false}]
                     [:file_hash [:varchar 64] {:null false}]
                     [:original_filename [:varchar 255]]
                     [:content_type [:varchar 100]]
                     [:file_size :integer]
                     [:file_purged_at :timestamptz]
                     [:status [:enum :receipt-status] {:null false :default "uploaded"}]

                     [:raw_extract_json :jsonb]
                     [:parsed_markdown :text]
                     [:supplier_guess [:varchar 255]]
                     [:supplier_alias_id :uuid {:foreign-key :supplier_aliases/id :on-delete :set-null}]
                     [:store_guess [:varchar 255]]
                     [:store_alias_id :uuid {:foreign-key :store_aliases/id :on-delete :set-null}]
                     [:total_amount_guess [:decimal 12 2]]
                     [:currency_guess [:enum :currency]]
                     [:purchased_at_guess :timestamptz]
                     [:error_message :text]
                     [:error_details :jsonb]
                     [:retry_count :integer {:default 0}]
                     [:expense_id :uuid]
                     [:created_at :timestamptz {:default [:now]}]
                     [:updated_at :timestamptz {:default [:now]}]]
            :types [[:receipt-status :enum {:choices ["uploaded" "parsing" "parsed"
                                                      "extracting" "extracted" "review_required"
                                                      "approved" "posted" "failed"]}]]
            :indexes [[:idx_receipts_tenant :btree {:fields [:tenant_id]}]

                      [:idx_receipts_tenant_subject :btree {:fields [:tenant_id :subject_ref]}]
                      [:idx_receipts_tenant_file_hash :btree {:fields [:tenant_id :file_hash] :unique true}]
                      [:idx_receipts_status :btree {:fields [:status]}]
                      [:idx_receipts_supplier_alias_id :btree {:fields [:supplier_alias_id]}]
                      [:idx_receipts_store_alias_id :btree {:fields [:store_alias_id]}]
                      [:idx_receipts_created_at :btree {:fields [:created_at]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Expense Categories (grouping for expenses) — tenant-scoped
 ;; ----------------------------------------------------------------------------

 :expense_categories {:fields [[:id :uuid {:primary-key true}]
                               [:tenant_id :uuid {:foreign-key :tenants/id :null false :on-delete :cascade}]
                               [:name [:varchar 255] {:null false}]
                               [:exclude_from_reports :boolean {:null false :default false}]
                               [:is_default :boolean {:null false :default false}]
                               [:created_at :timestamptz {:default [:now]}]
                               [:updated_at :timestamptz {:default [:now]}]]
                      :indexes [[:idx_expense_categories_tenant_name :btree {:fields [:tenant_id :name] :unique true}]
                                [:uniq_expense_categories_tenant_default
                                 :btree
                                 {:fields [:tenant_id :is_default]
                                  :unique true
                                  :where [:= :is_default true]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Expense Contexts (purpose/location reporting dimension) — tenant-scoped
 ;; ----------------------------------------------------------------------------

 :expense_contexts {:fields [[:id :uuid {:primary-key true}]
                             [:tenant_id :uuid {:foreign-key :tenants/id :null false :on-delete :cascade}]
                             [:name [:varchar 255] {:null false}]
                             [:description :text]
                             [:is_active :boolean {:null false :default true}]
                             [:created_by_subject_ref [:varchar 64]]
                             [:created_at :timestamptz {:default [:now]}]
                             [:updated_at :timestamptz {:default [:now]}]]
                    :indexes [[:idx_expense_contexts_tenant :btree {:fields [:tenant_id]}]
                              [:idx_expense_contexts_tenant_name
                               :btree
                               {:fields [:tenant_id :name] :unique true}]
                              [:idx_expense_contexts_tenant_active
                               :btree
                               {:fields [:tenant_id :is_active]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Expenses — tenant-scoped
 ;; ----------------------------------------------------------------------------

 :expenses {:fields [[:id :uuid {:primary-key true}]
                     [:tenant_id :uuid {:foreign-key :tenants/id :null false :on-delete :cascade}]

                     [:subject_ref [:varchar 64]]
                     [:created_by_subject_ref [:varchar 64]]
                     [:receipt_id :uuid {:foreign-key :receipts/id :on-delete :set-null}]
                     [:store_id :uuid {:foreign-key :stores/id :on-delete :set-null}]
                     [:supplier_id :uuid {:foreign-key :suppliers/id :on-delete :set-null}]
                     [:payer_id :uuid {:foreign-key :payers/id :null false}]
                     [:expense_category_id :uuid {:foreign-key :expense_categories/id :on-delete :set-null}]
                     [:expense_context_id :uuid {:foreign-key :expense_contexts/id :on-delete :set-null}]
                     [:purchased_at :timestamptz {:null false}]
                     [:total_amount [:decimal 12 2] {:null false}]
                     [:currency [:enum :currency] {:null false :default "BAM"}]
                     [:original_amount [:decimal 12 2]]
                     [:bam_amount [:decimal 12 2]]
                     [:exchange_rate [:decimal 18 8]]
                     [:rate_fetched_at :timestamptz]
                     [:notes :text]
                     [:created_at :timestamptz {:default [:now]}]
                     [:updated_at :timestamptz {:default [:now]}]]
            :types [[:currency :enum {:choices ["BAM" "EUR" "USD" "GBP" "CHF" "HRK" "RSD" "TRY"]}]]
            :indexes [[:idx_expenses_tenant :btree {:fields [:tenant_id]}]

                      [:idx_expenses_tenant_subject :btree {:fields [:tenant_id :subject_ref]}]
                      [:uniq_expenses_receipt_id :btree {:fields [:receipt_id] :unique true}]
                      [:idx_expenses_store :btree {:fields [:store_id]}]
                      [:idx_expenses_supplier :btree {:fields [:supplier_id]}]
                      [:idx_expenses_payer :btree {:fields [:payer_id]}]
                      [:idx_expenses_expense_category :btree {:fields [:expense_category_id]}]
                            [:idx_expenses_expense_context :btree {:fields [:expense_context_id]}]
                      [:idx_expenses_purchased_at :btree {:fields [:purchased_at]}]]}

                   ;; ----------------------------------------------------------------------------
                   ;; Expense Templates (tenant-shared guided/repeating entry presets) — tenant-scoped
                   ;; ----------------------------------------------------------------------------

                   :expense_templates {:fields [[:id :uuid {:primary-key true}]
                              [:tenant_id :uuid {:foreign-key :tenants/id :null false :on-delete :cascade}]
                              [:name [:varchar 255] {:null false}]
                              [:kind [:enum :expense-template-kind] {:null false :default "generic"}]
                              [:status [:enum :expense-template-status] {:null false :default "active"}]
                              [:created_by_subject_ref [:varchar 64]]
                              [:default_expense_category_id :uuid {:foreign-key :expense_categories/id :on-delete :set-null}]
                              [:default_expense_context_id :uuid {:foreign-key :expense_contexts/id :on-delete :set-null}]
                              [:default_supplier_id :uuid {:foreign-key :suppliers/id :on-delete :set-null}]
                              [:default_payer_id :uuid {:foreign-key :payers/id :on-delete :set-null}]
                              [:default_currency [:enum :currency] {:null false :default "BAM"}]
                              [:default_notes :text]
                              [:recurrence_frequency [:enum :recurrence-frequency]]
                              [:recurrence_interval :integer {:default 1}]
                              [:next_due_date :date]
                              [:reminder_days_before :integer {:null false :default 0}]
                              [:created_at :timestamptz {:default [:now]}]
                              [:updated_at :timestamptz {:default [:now]}]]
                           :types [[:expense-template-kind :enum {:choices ["utility" "recurring" "generic"]}]
                             [:expense-template-status :enum {:choices ["active" "archived"]}]
                             [:recurrence-frequency :enum {:choices ["weekly" "monthly" "quarterly" "yearly" "custom"]}]]
                           :indexes [[:idx_expense_templates_tenant_status :btree {:fields [:tenant_id :status]}]
                               [:idx_expense_templates_tenant_kind :btree {:fields [:tenant_id :kind]}]
                               [:idx_expense_templates_tenant_name :btree {:fields [:tenant_id :name]}]
                               [:idx_expense_templates_due :btree {:fields [:tenant_id :status :next_due_date]}]]}

                   ;; ----------------------------------------------------------------------------
                   ;; Expense Template Lines (line presets for templates) — tenant-scoped via template
                   ;; ----------------------------------------------------------------------------

                   :expense_template_lines {:fields [[:id :uuid {:primary-key true}]
                             [:template_id :uuid {:foreign-key :expense_templates/id :null false :on-delete :cascade}]
                             [:label [:varchar 255] {:null false}]
                             [:article_id :uuid {:foreign-key :articles/id :on-delete :set-null}]
                             [:default_amount [:decimal 12 2]]
                             [:sort_order :integer {:null false :default 0}]
                             [:is_active :boolean {:null false :default true}]
                             [:created_at :timestamptz {:default [:now]}]
                             [:updated_at :timestamptz {:default [:now]}]]
                          :indexes [[:idx_expense_template_lines_template_order
                               :btree
                               {:fields [:template_id :sort_order]}]
                              [:idx_expense_template_lines_article :btree {:fields [:article_id]}]]}

                   ;; ----------------------------------------------------------------------------
                   ;; Recurring Expense Reminders (in-app only) — tenant-scoped via template
                   ;; ----------------------------------------------------------------------------

                   :recurring_expense_reminders {:fields [[:id :uuid {:primary-key true}]
                            [:template_id :uuid {:foreign-key :expense_templates/id :null false :on-delete :cascade}]
                            [:due_date :date {:null false}]
                            [:status [:enum :recurring-expense-reminder-status] {:null false :default "pending"}]
                            [:reminded_at :timestamptz {:default [:now]}]
                            [:snoozed_until :timestamptz]
                            [:recorded_expense_id :uuid {:foreign-key :expenses/id :on-delete :set-null}]
                            [:skipped_at :timestamptz]
                            [:created_at :timestamptz {:default [:now]}]
                            [:updated_at :timestamptz {:default [:now]}]]
                               :types [[:recurring-expense-reminder-status
                            :enum
                            {:choices ["pending" "recorded" "skipped" "snoozed"]}]]
                               :indexes [[:uniq_recurring_expense_reminders_template_due
                              :btree
                              {:fields [:template_id :due_date] :unique true}]
                             [:idx_recurring_expense_reminders_template_status
                              :btree
                              {:fields [:template_id :status]}]
                             [:idx_recurring_expense_reminders_snoozed_until
                              :btree
                              {:fields [:snoozed_until]}]
                             [:idx_recurring_expense_reminders_recorded_expense
                              :btree
                              {:fields [:recorded_expense_id]}]]}

 ;; ----------------------------------------------------------------------------
 ;; User Expense Settings (per-user-per-tenant defaults) — tenant-scoped
 ;; ----------------------------------------------------------------------------

 :user_expense_settings {:fields [[:id :uuid {:primary-key true}]
                                  [:tenant_id :uuid {:foreign-key :tenants/id :null false :on-delete :cascade}]

                                  [:subject_ref [:varchar 64]]
                                  [:default_payer_id :uuid {:foreign-key :payers/id :on-delete :set-null}]
                                  [:receipt_ocr_provider :text {:null false :default "mistral"}]
                                  [:created_at :timestamptz {:default [:now]}]
                                  [:updated_at :timestamptz {:default [:now]}]]
                         :indexes [[:uniq_user_expense_settings_tenant_subject
                                    :btree
                                    {:fields [:tenant_id :subject_ref]
                                     :unique true
                                     :where [:raw "(subject_ref IS NOT NULL)"]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Raw Labels (deduplicated receipt line item labels) — global catalog
 ;; ----------------------------------------------------------------------------

 :raw_labels {:fields [[:id :uuid {:primary-key true}]
                       [:raw_label :text {:null false}]
                       [:normalized_key [:varchar 255] {:null false}]
                       [:created_at :timestamptz {:default [:now]}]
                       [:updated_at :timestamptz {:default [:now]}]]
              :indexes [[:idx_raw_labels_normalized_key :btree {:fields [:normalized_key] :unique true}]]}

 ;; ----------------------------------------------------------------------------
 ;; Expense Items (line items on receipts) — tenant-scoped
 ;; ----------------------------------------------------------------------------

 :expense_items {:fields [[:id :uuid {:primary-key true}]
                          [:tenant_id :uuid {:foreign-key :tenants/id :null false :on-delete :cascade}]
                          [:expense_id :uuid {:foreign-key :expenses/id :null false :on-delete :cascade}]
                          [:alias_id :uuid {:foreign-key :article_aliases/id :on-delete :set-null}]
                          [:article_id :uuid {:foreign-key :articles/id :on-delete :set-null}]
                          [:qty [:decimal 10 3]]
                          [:unit [:varchar 10]]
                          [:unit_price [:decimal 12 2]]
                          [:line_total [:decimal 12 2] {:null false}]
                          [:price_modified :boolean {:null false :default false}]
                          [:created_at :timestamptz {:default [:now]}]
                          [:updated_at :timestamptz {:default [:now]}]]
                 :indexes [[:idx_expense_items_tenant :btree {:fields [:tenant_id]}]
                           [:idx_expense_items_expense :btree {:fields [:expense_id]}]
                           [:idx_expense_items_article :btree {:fields [:article_id]}]
                           [:idx_expense_items_alias :btree {:fields [:alias_id]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Manufacturers (canonical brands) — global catalog
 ;; ----------------------------------------------------------------------------

 :manufacturers {:fields [[:id :uuid {:primary-key true}]
                          [:display_name [:varchar 255] {:null false}]
                          [:normalized_key [:varchar 255] {:null false}]
                          [:created_at :timestamptz {:default [:now]}]
                          [:updated_at :timestamptz {:default [:now]}]]
                 :indexes [[:idx_manufacturers_normalized_key
                            :btree
                            {:fields [:normalized_key] :unique true}]
                           [:idx_manufacturers_display_name
                            :btree
                            {:fields [:display_name]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Categories (high-level grouping for articles) — global catalog
 ;; ----------------------------------------------------------------------------

 :categories {:fields [[:id :uuid {:primary-key true}]
                       [:name [:varchar 255] {:null false}]
                       [:description :text]
                       [:created_at :timestamptz {:default [:now]}]
                       [:updated_at :timestamptz {:default [:now]}]]
              :indexes [[:idx_categories_name :btree {:fields [:name] :unique true}]]}

 ;; ----------------------------------------------------------------------------
 ;; Subcategories (child grouping under a category) — global catalog
 ;; ----------------------------------------------------------------------------

 :subcategories {:fields [[:id :uuid {:primary-key true}]
                          [:category_id :uuid {:foreign-key :categories/id :null false :on-delete :cascade}]
                          [:name [:varchar 255] {:null false}]
                          [:description :text]
                          [:created_at :timestamptz {:default [:now]}]
                          [:updated_at :timestamptz {:default [:now]}]]
                 :indexes [[:idx_subcategories_category_id :btree {:fields [:category_id]}]
                           [:idx_subcategories_category_name
                            :btree
                            {:fields [:category_id :name] :unique true}]]}

 ;; ----------------------------------------------------------------------------
 ;; Articles (canonical products/items) — global catalog
 ;; ----------------------------------------------------------------------------

 :articles {:fields [[:id :uuid {:primary-key true}]
                     [:canonical_name [:varchar 255] {:null false}]
                     [:normalized_key [:varchar 255] {:null false}]
                     [:unit [:varchar 10] {:null false :default "kom"}]
                     ;; Legacy free-text category (kept for Phase 1 backfill).

                     ;; New FK-driven categorization.

                     [:subcategory_id :uuid {:foreign-key :subcategories/id :on-delete :set-null}]
                     [:link :text]
                     ;; Canonical manufacturer reference.
                     [:manufacturer_id :uuid {:foreign-key :manufacturers/id :on-delete :set-null}]
                     [:created_at :timestamptz {:default [:now]}]
                     [:updated_at :timestamptz {:default [:now]}]]
            :indexes [[:idx_articles_normalized_key :btree {:fields [:normalized_key :unit] :unique true}]

                      [:idx_articles_subcategory_id :btree {:fields [:subcategory_id]}]
                      [:idx_articles_manufacturer_id :btree {:fields [:manufacturer_id]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Article Aliases (mapping raw labels → canonical articles) — global catalog
 ;; ----------------------------------------------------------------------------

 :article_aliases {:fields [[:id :uuid {:primary-key true}]
                            [:supplier_id :uuid {:foreign-key :suppliers/id :on-delete :cascade}]
                            [:raw_label :text]
                            [:raw_label_normalized [:varchar 255] {:null false}]
                            [:unit [:varchar 10] {:null false :default "kom"}]
                            [:article_id :uuid {:foreign-key :articles/id :on-delete :set-null}]
                            [:confidence :integer {:default 100}]
                            [:created_at :timestamptz {:default [:now]}]
                            [:updated_at :timestamptz {:default [:now]}]]
                   :indexes [[:idx_article_aliases_supplier_label :btree {:fields [:supplier_id :raw_label_normalized :unit] :unique true}]
                             [:idx_article_aliases_article :btree {:fields [:article_id]}]]}

 ;; ============================================================================
 ;; Settings Hierarchy Tables
 ;; ============================================================================

 ;; ----------------------------------------------------------------------------
 ;; Global Settings (singleton — platform-wide defaults)
 ;; ----------------------------------------------------------------------------

 :global_settings {:fields [[:id :uuid {:primary-key true}]
                            [:default_currency [:varchar 3] {:null false :default "BAM"}]
                            [:default_note :text]
                            [:auto_publish_after_upload :boolean {:null false :default false}]
                            [:ai_receipt_enhancement :boolean {:null false :default false}]
                            [:created_at :timestamptz {:default [:now]}]
                            [:updated_at :timestamptz {:default [:now]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Enabled Currencies (admin-curated list of available currencies)
 ;; ----------------------------------------------------------------------------

 :enabled_currencies {:fields [[:id :uuid {:primary-key true}]
                               [:code [:varchar 3] {:null false}]
                               [:name [:varchar 100] {:null false}]
                               [:is_base :boolean {:null false :default false}]
                               [:created_at :timestamptz {:default [:now]}]
                               [:updated_at :timestamptz {:default [:now]}]]
                      :indexes [[:uniq_enabled_currencies_code :btree {:fields [:code] :unique true}]]}

 ;; ----------------------------------------------------------------------------
 ;; Daily Exchange Rates (cached CBBH rates per currency per date)
 ;; ----------------------------------------------------------------------------

 :daily_exchange_rates {:fields [[:id :uuid {:primary-key true}]
                                 [:currency_code [:varchar 3] {:null false}]
                                 [:rate_date :date {:null false}]
                                 [:rate [:decimal 18 8] {:null false}]
                                 [:fetched_at :timestamptz]
                                 [:is_fallback :boolean {:null false :default false}]
                                 [:created_at :timestamptz {:default [:now]}]]
                        :indexes [[:uniq_daily_exchange_rates_currency_date
                                   :btree
                                   {:fields [:currency_code :rate_date] :unique true}]]}

 ;; ----------------------------------------------------------------------------
 ;; Exchange Rate Fetch Alerts (failures logged for admin awareness)
 ;; ----------------------------------------------------------------------------

 :exchange_rate_fetch_alerts {:fields [[:id :uuid {:primary-key true}]
                                       [:rate_date :date {:null false}]
                                       [:error_message :text]
                                       [:fallback_source_date :date]
                                       [:acknowledged :boolean {:null false :default false}]
                                       [:created_at :timestamptz {:default [:now]}]]
                              :indexes [[:idx_exchange_rate_fetch_alerts_date
                                         :btree
                                         {:fields [:rate_date]}]
                                        [:idx_exchange_rate_fetch_alerts_unacknowledged
                                         :btree
                                         {:fields [:acknowledged]
                                          :where [:= :acknowledged false]}]]}

 ;; ----------------------------------------------------------------------------
 ;; Tenant Settings (per-tenant configuration — one row per tenant)
 ;; ----------------------------------------------------------------------------

 :tenant_settings {:fields [[:id :uuid {:primary-key true}]
                            [:tenant_id :uuid {:foreign-key :tenants/id :null false :on-delete :cascade}]
                            [:email_notifications :boolean {:null false :default true}]
                            [:created_at :timestamptz {:default [:now]}]
                            [:updated_at :timestamptz {:default [:now]}]]
                   :indexes [[:uniq_tenant_settings_tenant :btree {:fields [:tenant_id] :unique true}]]}}
