{;; Users (application users)
 :users {:fields [[:id :uuid {:primary-key true}]
                  [:email_ciphertext :text {:null false}]
                  [:email_lookup_hash [:varchar 64] {:null false}]
                  [:email_key_version [:varchar 32] {:null false}]
                  [:full_name [:varchar 255]]
                  [:password_hash :text {:null false}]
                  [:status [:enum :user-status] {:null false :default "active"}]
                  [:email_verified :boolean {:default false :null false}]
                  [:last_login_at :timestamptz]
                  [:avatar_url :text]
                  [:auth_provider :text {:default "password"}]
                  [:created_at :timestamptz {:default [:now]}]
                  [:updated_at :timestamptz {:default [:now]}]]
         :types [[:user-status :enum {:choices ["active" "inactive" "suspended"]}]
                 [:audit-actor-type :enum {:choices ["user" "admin" "system"]}]
                 [:login-principal-type :enum {:choices ["user" "admin"]}]]
         :indexes [[:idx_users_email_lookup_hash :btree {:fields [:email_lookup_hash] :unique true}]
                   [:idx_users_status :btree {:fields [:status]}]
                   [:idx_users_email_verified :btree {:fields [:email_verified]}]
                   [:idx_users_created_at :btree {:fields [:created_at]}]]}

 ;; Admin users (system administrators)
 :admins {:fields [[:id :uuid {:primary-key true}]
                   [:email_ciphertext :text {:null false}]
                   [:email_lookup_hash [:varchar 64] {:null false}]
                   [:email_key_version [:varchar 32] {:null false}]
                   [:full_name [:varchar 255]]
                   [:password_hash :text {:null false}]
                   [:role [:enum :admin-role] {:null false :default "admin"}]
                   [:status [:enum :admin-status] {:null false :default "active"}]
                   [:last_login_at :timestamptz]
                   [:created_at :timestamptz {:default [:now]}]
                   [:updated_at :timestamptz {:default [:now]}]]
          :types [[:admin-role :enum {:choices ["admin" "support" "owner"]}]
                  [:admin-status :enum {:choices ["active" "suspended"]}]]
          :indexes [[:idx_admins_email_lookup_hash :btree {:fields [:email_lookup_hash] :unique true}]
                    [:idx_admins_status :btree {:fields [:status]}]
                    [:uniq_admins_active_owner :btree {:fields [:role]
                                                       :unique true
                                                       :where [:raw "((role = 'owner'::admin_role) AND (status = 'active'::admin_status))"]}]]}

 ;; Email verification tokens (single-tenant)
 :email_verification_tokens {:fields [[:id :uuid {:primary-key true}] [:user_id :uuid {:foreign-key :users/id :null false :on-delete :cascade}] [:token [:varchar 255] {:null false :unique true}] [:expires_at :timestamptz {:null false}] [:attempts :integer {:default 0}] [:last_attempted_at :timestamptz] [:used_at :timestamptz] [:created_at :timestamptz {:default [:now]}] [:updated_at :timestamptz {:default [:now]}]] :indexes [[:idx_email_tokens_user :btree {:fields [:user_id]}] [:idx_email_tokens_token :btree {:fields [:token] :unique true}] [:idx_email_tokens_expires :btree {:fields [:expires_at]}]]}

 ;; Audit logs for admin/user actions
 :audit_logs {:fields [[:id :uuid {:primary-key true}] [:actor_type [:enum :audit-actor-type] {:null false}] [:actor_id :uuid] [:action :text {:null false}] [:target_type :text] [:target_id :uuid] [:metadata :jsonb] [:ip :text] [:user_agent :text] [:created_at :timestamptz {:default [:now]}] [:updated_at :timestamptz {:default [:now]}]] :indexes [[:idx_audit_logs_created_at :btree {:fields [:created_at]}] [:idx_audit_logs_actor :btree {:fields [:actor_type :actor_id]}]]}

 ;; Login events for authentication monitoring
 :login_events {:fields [[:id :uuid {:primary-key true}] [:principal_type [:enum :login-principal-type] {:null false}] [:principal_id :uuid {:null false}] [:success :boolean {:null false}] [:reason :text] [:ip :text] [:user_agent :text] [:created_at :timestamptz {:default [:now]}] [:updated_at :timestamptz {:default [:now]}]] :indexes [[:idx_login_events_created_at :btree {:fields [:created_at]}] [:idx_login_events_principal :btree {:fields [:principal_type :principal_id]}]]}

 ;; Password reset tokens for users and admins
 :password_reset_tokens {:fields [[:id :uuid {:primary-key true}] [:principal_type [:enum :login-principal-type] {:null false}] [:principal_id :uuid {:null false}] [:token [:varchar 255] {:null false :unique true}] [:expires_at :timestamptz {:null false}] [:used_at :timestamptz] [:created_at :timestamptz {:default [:now]}] [:updated_at :timestamptz {:default [:now]}]] :indexes [[:idx_password_reset_tokens_token :btree {:fields [:token] :unique true}] [:idx_password_reset_tokens_principal :btree {:fields [:principal_type :principal_id]}] [:idx_password_reset_tokens_expires :btree {:fields [:expires_at]}]]}

 ;; Admin sessions for admin authentication
 :admin_sessions {:fields [[:id :uuid {:primary-key true}] [:admin_id :uuid {:foreign-key :admins/id :null false :on-delete :cascade}] [:token [:varchar 255] {:null false :unique true}] [:created_at :timestamptz {:null false :default [:now]}] [:updated_at :timestamptz {:null false :default [:now]}] [:last_activity :timestamptz {:null false}] [:expires_at :timestamptz {:null false}] [:ip_address :text] [:user_agent :text]] :indexes [[:idx_admin_sessions_token :btree {:fields [:token] :unique true}] [:idx_admin_sessions_admin_id :btree {:fields [:admin_id]}] [:idx_admin_sessions_expires :btree {:fields [:expires_at]}]]}

 ;; Admin invitations (email-based admin onboarding)
 :admin_invitations
 {:fields [[:id :uuid {:primary-key true}]
           [:email_ciphertext :text {:null false}]
           [:email_lookup_hash [:varchar 64] {:null false}]
           [:email_key_version [:varchar 32] {:null false}]
           [:role [:enum :admin-invitation-role] {:null false}]
           [:invited_by :uuid {:foreign-key :admins/id :null false :on-delete :cascade}]
           [:status [:enum :admin-invitation-status] {:null false :default "pending"}]
           [:token [:varchar 255] {:null false}]
           [:expires_at :timestamptz {:null false}]
           [:created_at :timestamptz {:default [:now]}]
           [:updated_at :timestamptz {:default [:now]}]]
  :types [[:admin-invitation-status :enum {:choices ["pending" "accepted" "expired" "revoked"]}]
          [:admin-invitation-role :enum {:choices ["support" "admin"]}]]
  :indexes [[:idx_admin_invitations_token :btree {:fields [:token] :unique true}]
            [:idx_admin_invitations_email_lookup_hash :btree {:fields [:email_lookup_hash]}]
            [:idx_admin_invitations_status :btree {:fields [:status]}]]}

 ;; Persisted runtime frontend config overrides for admin and user settings.
 ;; EDN files remain the source-controlled defaults; this table stores runtime saves.
 :frontend_runtime_configs {:fields [[:id :uuid {:primary-key true}]
                                     [:scope [:varchar 32] {:null false
                                                            :check [:raw "scope IN ('admin', 'user')"]}]
                                     [:config_key [:varchar 64] {:null false
                                                                 :check [:raw "config_key IN ('entities', 'view-options', 'form-fields', 'table-columns', 'navigation')"]}]
                                     [:config_edn :text {:null false}]
                                     [:created_at :timestamptz {:null false :default [:now]}]
                                     [:updated_at :timestamptz {:null false :default [:now]}]]
                            :indexes [[:uniq_frontend_runtime_configs_scope_key :btree {:fields [:scope :config_key] :unique true}]]}

 ;; Backlog items
 :backlog {:fields [[:number :integer {:primary-key true}] [:description :text {:null false}] [:status [:enum :backlog-status] {:null false :default "Waiting"}] [:type [:enum :backlog-type] {:null false}] [:created_at :timestamptz {:default [:now]}] [:updated_at :timestamptz {:default [:now]}]] :types [[:backlog-status :enum {:choices ["Waiting" "In progress" "Completed" "Need improvements"]}] [:backlog-type :enum {:choices ["Issue" "Feature" "Refactoring" "Review" "Improvement"]}]]}

 ;; ============================================================================
 ;; Multi-Tenancy Tables
 ;; ============================================================================

 ;; Tenants (workspace containers for multi-tenant isolation)
 :tenants {:fields [[:id :uuid {:primary-key true}]
                    [:name [:varchar 255] {:null false}]
                    [:slug [:varchar 255] {:null false}]
                    [:status [:enum :tenant-status] {:null false :default "active"}]
                    [:created_at :timestamptz {:default [:now]}]
                    [:updated_at :timestamptz {:default [:now]}]]
           :types [[:tenant-status :enum {:choices ["active" "suspended" "archived"]}]]
           :indexes [[:idx_tenants_slug :btree {:fields [:slug] :unique true}]
                     [:idx_tenants_status :btree {:fields [:status]}]]}

 ;; Tenant Memberships (user-to-tenant bindings with roles)
 :tenant_memberships {:fields [[:id :uuid {:primary-key true}]
                               [:tenant_id :uuid {:foreign-key :tenants/id :null false :on-delete :cascade}]
                               [:user_id :uuid {:foreign-key :users/id :null false :on-delete :cascade}]
                               [:role [:enum :membership-role] {:null false}]
                               [:status [:enum :membership-status] {:null false :default "active"}]
                               [:invited_by :uuid {:foreign-key :users/id :on-delete :set-null}]
                               [:created_at :timestamptz {:default [:now]}]
                               [:updated_at :timestamptz {:default [:now]}]]
                      :types [[:membership-role :enum {:choices ["owner" "admin" "member" "viewer"]}]
                              [:membership-status :enum {:choices ["active" "suspended"]}]]
                      :indexes [[:uniq_tenant_memberships_tenant_user :btree {:fields [:tenant_id :user_id] :unique true}]
                                [:uniq_tenant_memberships_active_owner :btree {:fields [:tenant_id]
                                                                               :unique true
                                                                               :where [:raw "((role = 'owner'::membership_role) AND (status = 'active'::membership_status))"]}]
                                [:idx_tenant_memberships_user :btree {:fields [:user_id]}]
                                [:idx_tenant_memberships_status :btree {:fields [:status]}]]}

 ;; Tenant Invitations (pending invitations to join a tenant)
 :tenant_invitations {:fields [[:id :uuid {:primary-key true}]
                               [:tenant_id :uuid {:foreign-key :tenants/id :null false :on-delete :cascade}]
                               [:email_ciphertext :text {:null false}]
                               [:email_lookup_hash [:varchar 64] {:null false}]
                               [:email_key_version [:varchar 32] {:null false}]
                               [:role [:enum :invitation-role] {:null false}]
                               [:invited_by :uuid {:foreign-key :users/id :null false :on-delete :cascade}]
                               [:status [:enum :invitation-status] {:null false :default "pending"}]
                               [:token [:varchar 255] {:null false}]
                               [:expires_at :timestamptz {:null false}]
                               [:created_at :timestamptz {:default [:now]}]
                               [:updated_at :timestamptz {:default [:now]}]]
                      :types [[:invitation-status :enum {:choices ["pending" "accepted" "expired" "revoked"]}]
                              [:invitation-role :enum {:choices ["admin" "member" "viewer"]}]]
                      :indexes [[:idx_tenant_invitations_token :btree {:fields [:token] :unique true}]
                                [:idx_tenant_invitations_tenant :btree {:fields [:tenant_id]}]
                                [:idx_tenant_invitations_email_lookup_hash :btree {:fields [:email_lookup_hash]}]
                                [:idx_tenant_invitations_status :btree {:fields [:status]}]]}

 :payment_provider_account_links
 {:fields [[:id :uuid {:primary-key true}]
           [:account_kind [:enum :payment-provider-account-kind] {:null false}]
           [:account_id :uuid {:null false}]
           [:provider [:varchar 64] {:null false}]
           [:provider_customer_ref [:varchar 255] {:null false}]
           [:status :text {:null false :default "active"}]
           [:created_at :timestamptz {:default [:now]}]
           [:updated_at :timestamptz {:default [:now]}]]
  :types [[:payment-provider-account-kind :enum {:choices ["user" "tenant"]}]]
  :indexes [[:uniq_payment_provider_account_links_account_provider
             :btree
             {:fields [:account_kind :account_id :provider] :unique true}]
            [:uniq_payment_provider_account_links_provider_customer_ref
             :btree
             {:fields [:provider :provider_customer_ref] :unique true}]
            [:idx_payment_provider_account_links_account
             :btree
             {:fields [:account_kind :account_id]}]
            [:idx_payment_provider_account_links_status
             :btree
             {:fields [:status]}]]}

 ;; User Sessions (server-side session store)
 :user_sessions {:fields [[:id :uuid {:primary-key true}]
                          [:session_key [:varchar 255] {:null false}]
                          [:data :jsonb {:null false}]
                          [:expires_at :timestamptz {:null false}]
                          [:created_at :timestamptz {:default [:now]}]
                          [:updated_at :timestamptz {:default [:now]}]]
                 :indexes [[:idx_user_sessions_key :btree {:fields [:session_key] :unique true}]
                           [:idx_user_sessions_expires :btree {:fields [:expires_at]}]]}

 ;; ============================================================================
 ;; Workspace Onboarding
 ;; ============================================================================

 ;; Onboarding progress — keyed on (user_id, role), NOT per membership.
 ;; A user who is "owner" in two workspaces shares one onboarding record.
 :onboarding_progress
 {:fields [[:id :uuid {:primary-key true}]
           [:user_id :uuid {:foreign-key :users/id :null false :on-delete :cascade}]
           [:role [:enum :membership-role] {:null false}]
           [:dismissed :boolean {:null false :default false}]
           [:created_at :timestamptz {:default [:now]}]
           [:updated_at :timestamptz {:default [:now]}]]
  :types [[:onboarding-step-kind :enum
           {:choices ["name_workspace" "setup_profile" "rename_default_category" "configure_categories"
                      "review_payer_types" "invite_members" "management_intro"
                      "upload_first_receipt" "browse_intro"]}]
          [:onboarding-step-status :enum
           {:choices ["pending" "completed" "skipped"]}]]
  :indexes [[:uniq_onboarding_progress_user_role :btree
             {:fields [:user_id :role] :unique true}]
            [:idx_onboarding_progress_user :btree
             {:fields [:user_id]}]]}

 ;; Onboarding steps — individual steps within a progress record.
 ;; step_order avoids SQL reserved word "order".
 :onboarding_steps
 {:fields [[:id :uuid {:primary-key true}]
           [:progress_id :uuid {:foreign-key :onboarding_progress/id :null false :on-delete :cascade}]
           [:kind [:enum :onboarding-step-kind] {:null false}]
           [:step_order :integer {:null false}]
           [:status [:enum :onboarding-step-status] {:null false :default "pending"}]
           [:completed_at :timestamptz]
           [:created_at :timestamptz {:default [:now]}]
           [:updated_at :timestamptz {:default [:now]}]]
  :indexes [[:uniq_onboarding_steps_progress_kind :btree
             {:fields [:progress_id :kind] :unique true}]
            [:idx_onboarding_steps_progress :btree
             {:fields [:progress_id]}]
            [:idx_onboarding_steps_status :btree
             {:fields [:status]}]]}}