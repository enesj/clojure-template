{:paths ["scripts/bb" "src" "test"],
 :deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
        etaoin/etaoin {:mvn/version "1.0.40"}
        org.clojure/data.json {:mvn/version "2.4.0"}
        com.taoensso/timbre {:mvn/version "6.3.1"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.981"}
        org.postgresql/postgresql {:mvn/version "42.7.4"}
        metosin/malli {:mvn/version "0.20.0"
                       :exclusions [metosin/spec-tools]}
        rewrite-clj/rewrite-clj {:mvn/version "1.1.47"}
        aero/aero {:mvn/version "1.1.6"}}
 :tasks {:init (do
                 (require '[aero.core :as aero])
                 (require '[clojure.java.io :as io])
                 (require '[clojure.string :as str])
                 (defn dotenv
                   "Parse .env in project root; returns a {\"KEY\" \"val\"} map.
                    Skips blank lines and # comments. Safe when .env does not exist."
                   []
                   (let [f (io/file ".env")]
                     (if (.exists f)
                       (->> (str/split-lines (slurp f))
                         (remove (fn [line]
                                   (or (str/blank? line)
                                     (str/starts-with? (str/trim line) "#"))))
                         (keep (fn [line]
                                 (let [idx (str/index-of line "=")]
                                   (when (and idx (pos? idx))
                                     [(str/trim (subs line 0 idx))
                                      (subs line (inc idx))]))))
                         (into {}))
                       {}))))
         check-deps
         {:doc "Check for available dependency upgrades without making any changes",
          :task (shell "neil dep upgrade --dry-run")},

         upgrade-deps
         {:doc "Automatically upgrade all project dependencies to their latest versions",
          :task (shell "neil dep upgrade")},

         single-dep-upgrade
         {:doc "Upgrade a specific dependency to its latest version. Usage: bb single-dep-upgrade [dep-name]",
          :task
          (let [[dep] *command-line-args*]
            (shell "neil dep upgrade --lib" dep))},

         find-lib
         {:doc "Search for a Clojure library in public repositories. Usage: bb find-lib [search-term]",
          :task (let [[query] *command-line-args*]
                  (shell "neil dep search " query))},

         show-versions
         {:doc "Display all available versions for a specific library. Usage: bb show-versions [lib-name]",
          :task (let [[lib] *command-line-args*]
                  (shell "neil dep versions --lib " lib))},

         add-lib-to-deps
         {:doc "Add a library to your project's deps.edn file. Usage: bb add-lib-to-deps [lib-name]",
          :task (let [[lib] *command-line-args*]
                  (shell "neil add dep :lib  " lib))},

         rename-ns
         {:doc "Rename a namespace across the entire project. Usage: bb rename-ns [old-ns] [new-ns]",
          :task (let [[old-ns new-ns] *command-line-args*]
                  (shell "clojure-lsp" "rename" "--from" old-ns "--to" new-ns))},

         list-alias-deps
         {:doc "List dependencies for specific aliases. First arg is 'list' or 'tree' (default: tree). Usage: bb list-alias-deps [list|tree] [alias1] [alias2] ...",
          :task (let [aliases *command-line-args*
                      type (first aliases)
                      type (or (#{"list" "tree"} type) "tree")
                      aliases (map keyword aliases)
                      aliases (str "[" (clojure.string/join ", " aliases) "]")]
                  (shell "clj" "-X:deps" type ":aliases " aliases))},

         combine-files
         {:doc "Combine project files into a single text file. The output file name is based on the included folders.
        Usage: bb combine-files [folder1] [folder2] ...
        If no folders are specified, all files will be combined.",
          :task (let [args *command-line-args*]
                  (println "Combining files...")
                  (apply shell "bb" "scripts/bb/project-management/file_combiner.clj" args))},

         audit-bundle
         {:doc "Create a provenance-preserving evidence bundle (ripgrep JSON) for Lattice-based audits.\n\nUsage:\n  bb audit-bundle --query <regex> [--query <regex> ...] [--glob <glob> ...] [--context N] [--label <slug>] [--out <path>]",
          :task (apply shell "bb" "scripts/bb/ai/audit_bundle.clj" *command-line-args*)},

         schedule-claude
         {:doc "Schedule Claude CLI commands to run at a specific time using the 'at' command.\n\nUsage:\n  bb schedule-claude --prompt \"YOUR_PROMPT\" --time \"TIME_SPEC\"\n  bb schedule-claude -p \"YOUR_PROMPT\" -t \"TIME_SPEC\" [-l LOG_PATH]\n\nOptions:\n  -p, --prompt   The prompt to send to Claude CLI\n  -t, --time     Time specification for the 'at' command\n  -l, --log      Log file path (default: tmp/claude-scheduled.log)\n\nTime Examples:\n  \"2AM tomorrow\"       - Run at 2 AM tomorrow\n  \"3PM today\"          - Run at 3 PM today\n  \"now + 1 hour\"       - Run in 1 hour\n  \"now + 30 minutes\"   - Run in 30 minutes\n\nLogging:\n  Output is logged to the specified file (default: tmp/claude-scheduled.log)\n  Check execution status with: cat tmp/claude-scheduled.log\n\nNote: Requires 'at' command to be installed and atd service running.",
          :task (apply shell "bb" "scripts/bb/ai/schedule_claude.clj" *command-line-args*)},

         config-audit
         {:doc "Audit frontend config EDN keys for potential unused settings. Usage: bb config-audit [--strict] [--allowlist <path>]",
          :task (apply shell {:extra-env (dotenv)} "bb" "scripts/bb/config_audit.clj" *command-line-args*)},

         validate-frontend-config
         {:doc "Validate frontend config EDN files against Malli specs + DB schema alignment. Usage: bb validate-frontend-config [--only <domain>] [--skip <domain>] [--allowlist <path>] [--schema <path>]",
          :task (apply shell {:extra-env (dotenv)} "bb" "scripts/bb/validate_frontend_config.clj" *command-line-args*)},

         legacy-inventory
         {:doc "Generate a machine-readable inventory of legacy patterns. Writes to resources/legacy-inventory.edn.",
          :task (shell "bb" "scripts/legacy/inventory.bb" "--out" "resources/legacy-inventory.edn" "--quiet")},

         legacy-audit
         {:doc "Fail if new legacy occurrences are introduced compared to resources/legacy-inventory.edn. Use --strict to require zero occurrences.",
          :task (apply shell "bb" "scripts/legacy/audit.bb" *command-line-args*)},

         sync-frontend-config
         {:doc "Sync frontend config EDNs with DB schema (dry-run by default). Usage: bb sync-frontend-config [--apply] [--only <domain>] [--skip <domain>] [--allowlist <path>] [--schema <path>]",
          :task (apply shell {:extra-env (dotenv)} "bb" "scripts/bb/sync_frontend_config.clj" *command-line-args*)},

         export-frontend-config-from-db
         {:doc "Promote DB-backed frontend config snapshots into source-controlled EDN defaults (dry-run by default). Usage: bb export-frontend-config-from-db [--profile <profile>] [--only <domain>] [--skip <domain>] [--apply]. Dry-run exits nonzero when pending file updates are found.",
          :task (apply shell {:extra-env (dotenv)} "bb" "scripts/bb/export_frontend_config_from_db.clj" *command-line-args*)},

         railway-frontend-config
         {:doc "Run frontend-config tasks against Railway production. Usage: bb railway-frontend-config <validate-frontend-config|sync-frontend-config|export-frontend-config-from-db|migrate-and-sync-frontend-config> [args...]",
          :task (apply shell {:extra-env (dotenv)} "bb" "scripts/bb/railway_frontend_config.clj" *command-line-args*)},

         railway-validate-frontend-config
         {:doc "Run frontend-config validation in the Railway production workflow. Usage: bb railway-validate-frontend-config [--only <domain>] [--skip <domain>] [--allowlist <path>] [--schema <path>]",
          :task (apply shell {:extra-env (dotenv)} "bb" "scripts/bb/railway_frontend_config.clj" "validate-frontend-config" *command-line-args*)},

         railway-sync-frontend-config
         {:doc "Run frontend-config sync in the Railway production workflow (dry-run by default). Usage: bb railway-sync-frontend-config [--apply] [--only <domain>] [--skip <domain>] [--allowlist <path>] [--schema <path>]",
          :task (apply shell {:extra-env (dotenv)} "bb" "scripts/bb/railway_frontend_config.clj" "sync-frontend-config" *command-line-args*)},

         railway-export-frontend-config-from-db
         {:doc "Promote Railway production frontend config snapshots into source-controlled EDN defaults (dry-run by default). Usage: bb railway-export-frontend-config-from-db [--only <domain>] [--skip <domain>] [--apply]",
          :task (apply shell {:extra-env (dotenv)} "bb" "scripts/bb/railway_frontend_config.clj" "export-frontend-config-from-db" *command-line-args*)},

         railway-migrate-and-sync-frontend-config
         {:doc "Run migrations, apply frontend-config sync, and validate against Railway production. Usage: bb railway-migrate-and-sync-frontend-config [--only <domain>] [--skip <domain>] [--allowlist <path>] [--schema <path>]",
          :task (apply shell {:extra-env (dotenv)} "bb" "scripts/bb/railway_frontend_config.clj" "migrate-and-sync-frontend-config" *command-line-args*)},

         migrate-and-sync-frontend-config
         {:doc "Run migrations, apply frontend config sync, then validate. Usage: bb migrate-and-sync-frontend-config [--profile <profile>] [--only <domain>] [--skip <domain>] [--allowlist <path>] [--schema <path>]",
          :task (apply shell {:extra-env (dotenv)} "bb" "scripts/bb/migrate_and_sync_frontend_config.clj" *command-line-args*)},

         guard-no-concrete-domain
         {:doc "Fail if template/admin/shared contain concrete domain coupling. Usage: bb guard-no-concrete-domain [--strict]",
          :task (apply shell "bb" "scripts/bb/guard_no_concrete_domain.clj" *command-line-args*)},

         commit
         {:doc "Auto-commit with AI message. Modes: `bb commit` (commit only), `bb commit test` (run tests when code files changed, then commit), `bb commit push` (run tests when code files changed, commit, then push).",
          :task (load-file "scripts/bb/project-management/auto_commit.clj")},

         cljfmt-check
         {:doc "Check code formatting with cljfmt",
          :task (shell "cljfmt" "check" "src" "test")},

         cljfmt-fix
         {:doc "Fix code formatting with cljfmt",
          :task (do
                  (println "🔧 Fixing code formatting with cljfmt...")
                  (shell "cljfmt" "fix" "src" "test")
                  (println "✅ Code formatting fixed!"))},

         lint
         {:doc "Run clj-kondo lint across src, dev, test folders",
          :task (do
                  (printf "\033]0;🔍 Linting Code\007")
                  (flush)
                  (shell "clj-kondo" "--parallel" "--cache" "false" "--lint" "src" "dev" "test"))},

         nvd-check
         {:doc "Check dependencies for known vulnerabilities (requires NVD API key for full functionality)",
          :task (do (println "Note: For full functionality, obtain an NVD API key from https://nvd.nist.gov/developers/request-an-api-key")
                  (println "Create nvd-clojure.edn with: {:nvd {:nvd-api {:key \"your-api-key\"}}}")
                  (let [classpath (-> (shell {:out :string} "clj" "-Spath") :out clojure.string/trim)]
                    (shell "clj" "-Sdeps" "{:aliases {:nvd {:replace-deps {nvd-clojure/nvd-clojure {:mvn/version \"4.0.0\"}}}}}"
                      "-J-Dclojure.main.report=stderr" "-T:nvd" "nvd.task/check"
                      ":classpath" (str "\"" classpath "\""))))},

         clean-cache
         {:doc "Delete Shadow-CLJS caches and compiled output",
          :task (do
                  (printf "\033]0;🧹 Cleaning Cache\007")
                  (flush)
                  (shell "bash" "./scripts/sh/build/clean-cljs-cache.sh"))},

         run-app
         {:doc "Start the application server (add --clean to clear caches first)",
          :task (let [args *command-line-args*
                      clean? (some #{"--clean"} args)]
                  (printf "\033]0;🚀 Hosting App Server\007")
                  (flush)
                  (when clean? (shell "bash" "./scripts/sh/build/clean-cljs-cache.sh"))
                  (shell "./scripts/sh/development/run-app.sh"))},

         kill-java
         {:doc "Kill all Java processes",
          :task (shell "./scripts/sh/development/kill-java.sh")},

         fix-docstrings
         {:doc "Automatically fix clj-kondo 'Misplaced docstring.' warnings",
          :task (apply shell "bb" "scripts/bb/code_quality/fix_misplaced_docstrings.clj" *command-line-args*)},

         unused-public-var
         {:doc "Find unused code via clojure-lsp (public-var, namespace, referred-var, private-var). Usage: bb unused-public-var [--domain] [--template] [--admin] [--shared] [-o <path>]\n\nDefault: domain + admin only. Flags filter to specific paths. Vendor always excluded.",
          :task (apply shell "bb" "scripts/bb/code_quality/unused_public_var.clj" *command-line-args*)},

         fix-str-warnings
         {:doc "Remove redundant (str ...) calls flagged by clj-kondo",
          :task (shell "bb" "scripts/bb/code-quality/fix_str_warnings.clj")},

         repair-lints
         {:doc "Fix clj-kondo unused binding warnings and run clojure-lsp clean-ns on affected files",
          :task (shell "./scripts/repair-lints.clj")},

         be-test
         {:doc "Run backend tests using Kaocha",
          :task (do
                  (printf "\033]0;🧪 Backend Tests\007")
                  (flush)
                  (shell {:extra-env (dotenv)} "clj -M:test -m kaocha.runner :app.backend"))},

         e2e-test
         {:doc "Run E2E tests (Playwright + headless Chromium against test system on port 8086). Usage: bb e2e-test [--focus NS]",
          :task (do
                  (printf "\033]0;🌐 E2E Tests\007")
                  (flush)
                  (let [args *command-line-args*
                        focus-ns (when (and (seq args) (= "--focus" (first args)))
                                   (second args))
                        cmd (if focus-ns
                              (str "clj -M:test -m kaocha.runner --focus " focus-ns " :e2e")
                              "clj -M:test -m kaocha.runner :e2e")]
                    (shell {:extra-env (dotenv)} cmd)))},

         fe-test
         {:doc "Alias for frontend tests (same as fe-test-node). Usage: bb fe-test [start] [lines]",
          :task (apply shell "bb" "fe-test-node" *command-line-args*)},

         fe-test-node
         {:doc "Run frontend tests once using Shadow CLJS (Node). Usage: bb fe-test-node [start] [lines] (or bb fe-test)
        If start is provided, skips that many lines before showing output. Defaults to 0.
        If lines is provided, shows that many lines of output. Defaults to 50.",
          :task (let [args *command-line-args*
                      start (if (empty? args) "0" (first args))
                      lines (if (or (empty? args) (= (count args) 1))
                              "50"
                              (second args))
                      start-int (try (Integer/parseInt start) (catch Exception _ 0))
                      lines-int (try (Integer/parseInt lines) (catch Exception _ 50))
                      timeout-ms 50000
                      command (str "source ~/.zshrc && npm run test:cljs")]
                  (printf "\033]0;🧪 Frontend Tests\007")
                  (flush)
                  (println (str "🧪 Running frontend tests"))
                  (when (not= start "0")
                    (println (str "   Starting from line " start)))
                  (println (str "   Showing " lines-int " lines of output"))
                  (let [pb (doto (ProcessBuilder. (into-array String ["zsh" "-c" command]))
                             (.redirectErrorStream true))
                        proc (.start pb)
                        collected (java.util.ArrayList.)
                        reader-fut (future
                                     (with-open [r (clojure.java.io/reader (.getInputStream proc))]
                                       (doseq [line (line-seq r)]
                                         (.add collected line))))
                        completed? (.waitFor proc timeout-ms java.util.concurrent.TimeUnit/MILLISECONDS)]
                    (when (not completed?)
                      (println (str "❌ Frontend tests timed out after " (/ timeout-ms 1000) " seconds"))
                      (.destroyForcibly proc)
                      (.waitFor proc 5 java.util.concurrent.TimeUnit/SECONDS))
                    (try (deref reader-fut) (catch Throwable _ nil))
                    (doseq [l (take lines-int (drop start-int (seq collected)))]
                      (println l))
                    (when (and completed? (not= 0 (.exitValue proc)))
                      (throw (ex-info "Frontend tests exited with non-zero code" {:exit-code (.exitValue proc)}))))
                  (println (str "✅ Test output processed (start: " start-int ", lines: " lines-int ")")))},

         fe-test-parallel
         {:doc "Run frontend CLJS tests in parallel (Node workers, sharded). Pass through args to scripts/bb/fe_test_parallel.clj.\n\nUsage:\n  bb fe-test-parallel [--workers N] [--grep REGEX] [--randomize] [--skip-compile] [--dry-run]",
          :task (apply shell "bb" "scripts/bb/fe_test_parallel.clj" *command-line-args*)}

         stage
         {:doc "Stage all changes for git commit",
          :task (shell "git" "add" ".")},

         build-prod
         {:doc "Build the hosting app for production deployment",
          :task (do
                  (printf "\033]0;🏗️ Production Build\007")
                  (flush)
                  (shell "./scripts/sh/build/build-production.sh"))},

         install-completions
         {:doc "Install bb task autocompletion for your shell",
          :task (shell "./scripts/sh/setup/install-completions.sh")},

         archive-secrets
         {:doc "Manage the encrypted local Secrets disk. Defaults to interactive Projects/General selection, stores project snapshots under Projects/<project-name>, and commits the selected local repo. Usage: bb archive-secrets [script args...]",
          :task (apply shell "bash" "scripts/sh/setup/archive-railway-env-to-encrypted-disk-image.sh" "--gui-passphrase" "--overwrite" *command-line-args*)},

         secrets-commit-projects
         {:doc "Commit changes in the encrypted Secrets Projects repo. Defaults to a UTC timestamp message and prompts for the project folder when needed. Usage: bb secrets-commit-projects [message] [script args...]",
          :task (let [args *command-line-args*
                      first-arg (first args)
                      message-provided? (and first-arg (not (.startsWith first-arg "--")))
                      message (if message-provided?
                                first-arg
                                (str "Projects " (java.time.ZonedDateTime/now java.time.ZoneOffset/UTC)))
                      extra-args (if message-provided?
                                   (rest args)
                                   args)]
                  (apply shell "bash"
                    "scripts/sh/setup/archive-railway-env-to-encrypted-disk-image.sh"
                    "--gui-passphrase"
                    "--projects"
                    "--commit-only"
                    "--commit-message"
                    message
                    extra-args))},

         secrets-commit-general
         {:doc "Commit changes in the encrypted Secrets General repo. Defaults to a UTC timestamp message. Usage: bb secrets-commit-general [message] [script args...]",
          :task (let [args *command-line-args*
                      first-arg (first args)
                      message-provided? (and first-arg (not (.startsWith first-arg "--")))
                      message (if message-provided?
                                first-arg
                                (str "General " (java.time.ZonedDateTime/now java.time.ZoneOffset/UTC)))
                      extra-args (if message-provided?
                                   (rest args)
                                   args)]
                  (apply shell "bash"
                    "scripts/sh/setup/archive-railway-env-to-encrypted-disk-image.sh"
                    "--gui-passphrase"
                    "--general"
                    "--commit-only"
                    "--commit-message"
                    message
                    extra-args))},

         create-new-app
         {:doc "Create a new Clojure application based on the hosting app template.

         Usage: bb create-new-app <project-name> [options]

         Options:
         --title \"App Title\"        Application title (default: auto-generated)
         --db-name \"database\"       Database name (default: same as project name)
         --package-name \"pkg\"       Package name (default: same as project name)
         --target-dir \"/path\"       Target directory (default: ../project-name)
         --config \"/path/file.edn\"  Read configuration from EDN file
         --help                    Show detailed help

         Configuration File Support:
         Create new-app-config.edn to set default values:
         {:defaults {:title \"My Company App\"
                    :db-name-suffix \"-db\"
                    :package-name-prefix \"company-\"
                    :target-dir \"~/Projects\"}}

         The script will automatically use new-app-config.edn if present and ask
         if you want to use those settings or modify them interactively.

         Examples:
         bb create-new-app invoice-system
         bb create-new-app my-app --title \"My Application\" --db-name \"myapp_db\"
         bb create-new-app invoice-system --config ./custom-config.edn",
          :task (let [args *command-line-args*]
                  (if (empty? args)
                    (shell "bb" "scripts/bb/project-management/create_new_app.clj" "--help")
                    (apply shell "bb" "scripts/bb/project-management/create_new_app.clj" args)))},

         clear-folder
         {:doc "Clear temporary project folders.\n\n       Options:\n         --tmp              Clear the tmp folder\n         --projectstmp      Clear the projectstmp folder\n         --test-screenshots Clear the test-screenshots folder\n         --all              Clear all above folders (default if no option given)\n\n       Usage:\n         bb clear-temp --tmp\n         bb clear-temp --all\n       ",
          :task (let [args (set *command-line-args*)
                      dir-map {"--tmp" "tmp"
                               "--projectstmp" "projectstmp"
                               "--test-screenshots" "test-screenshots"}
                      dirs (if (or (empty? args) (args "--all"))
                             (vals dir-map)
                             (keep dir-map args))]
                  (doseq [d dirs]
                    (when (.exists (java.io.File. d))
                      (println (str "🧹 Clearing " d "..."))
                      (doseq [f (.listFiles (java.io.File. d))]
                        (when (.isFile f) (.delete f)))
                      (doseq [sub (.listFiles (java.io.File. d))]
                        (when (.isDirectory sub)
                          (shell "bash" "-c" (str "rm -rf " (.getPath sub)))))))
                  (println "✅ Selected temporary folders cleared."))}

         receipt-file-janitor
         {:doc "Purge finalized receipt files and delete orphaned files from upload/stripes. Usage: bb receipt-file-janitor [dev|test|prod] [--dry-run] [--older-than-days N] [--limit N] [--orphan-limit N] [--loop]",
          :task (apply shell {:extra-env (dotenv)} "clj" "-M" "scripts/bb/expenses/receipt_file_janitor.clj" *command-line-args*)},

         privacy-subject-backfill
         {:doc "Backfill/check expense/receipt privacy subject refs. Dry-run by default. Usage: bb privacy-subject-backfill [dev|test|prod] [--apply] [--cutover] [--check-complete] [--limit N] [--yes] [--pretty]",
          :task (apply shell {:extra-env (dotenv)} "clj" "-M" "scripts/bb/expenses/privacy_subject_backfill.clj" *command-line-args*)},

         backup-db
         {:doc "Create a backup of dev or test database. Usage: bb backup-db --dev or bb backup-db --test",
          :task (let [args *command-line-args*
                      env (cond
                            (some #{"--dev"} args) "dev"
                            (some #{"--test"} args) "test"
                            :else nil)]
                  (if env
                    (shell {:extra-env (dotenv)} "clj" "-M" "scripts/bb/database/backup_db.clj" env)
                    (do (println "Usage: bb backup-db --dev or bb backup-db --test")
                      (println "  --dev   Backup development database")
                      (println "  --test  Backup test database"))))},

         restore-db
         {:doc "Restore a database from backup file. Usage: bb restore-db --dev backup_file.sql or bb restore-db --test backup_file.sql",
          :task (let [args *command-line-args*
                      env (cond
                            (some #{"--dev"} args) "dev"
                            (some #{"--test"} args) "test"
                            :else nil)
                      non-flag-args (filter (fn [arg] (not (.startsWith arg "--"))) args)
                      backup-file (last non-flag-args)]
                  (if (and env backup-file)
                    (shell {:extra-env (dotenv)} "clj" "-M" "scripts/bb/database/restore_db_legacy.clj" env backup-file)
                    (do (println "Usage: bb restore-db --dev backup_file.sql or bb restore-db --test backup_file.sql")
                      (println "  --dev   Restore to development database")
                      (println "  --test  Restore to test database")
                      (println "Examples:")
                      (println "  bb restore-db --dev backups/backup_dev_2025-06-27_19-58-16.sql")
                      (println "  bb restore-db --test backups/backup_dev_2025-06-27_19-58-16.sql"))))},

         clean-restore-db
         {:doc "Clean restore: Drop target database completely, then restore from backup. Usage: bb clean-restore-db --dev backup_file.sql or bb clean-restore-db --test backup_file.sql",
          :task (let [args *command-line-args*
                      env (cond
                            (some #{"--dev"} args) "dev"
                            (some #{"--test"} args) "test"
                            :else nil)
                      non-flag-args (filter (fn [arg] (not (.startsWith arg "--"))) args)
                      backup-file (last non-flag-args)]
                  (if (and env backup-file)
                    (let [process-env (dotenv)]
                      (println "🔄 Step 1/2: Cleaning database...")
                      (shell {:extra-env process-env} "clj" "-M" "scripts/bb/database/clean_db.clj" env)
                      (println "🔄 Step 2/2: Restoring from backup...")
                      (shell {:extra-env process-env} "clj" "-M" "scripts/bb/database/restore_db_script.clj" env backup-file))
                    (do (println "Usage: bb clean-restore-db --dev backup_file.sql or bb clean-restore-db --test backup_file.sql")
                      (println "  --dev   Clean restore to development database")
