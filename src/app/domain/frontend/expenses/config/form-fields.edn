{:expense-items
 {:edit-fields ["article_id" "qty" "unit" "unit_price" "line_total"],
  :field-config
  {:article_id
   {:type "select",
    :label "Article",
    :options ["articles" "canonical_name"]},
   :qty {:type "number", :step 0.001},
   :unit {:type "select", :label "Unit", :options ["kom" "kg" "g" "l" "pak"]},
   :unit_price {:type "number", :step 0.01},
   :line_total {:type "number", :step 0.01}},
  :removed-fields {:edit-fields ["raw_label"]}},
 :subcategories
 {:create-fields ["category_id" "name" "description"],
  :edit-fields ["name" "description"],
  :field-config
  {:category_id
   {:type "select", :label "Category", :options ["categories" "name"]},
   :name {:type "text", :label "Name"},
   :description {:type "textarea", :label "Description"}}},
 :cities
 {:create-fields ["name"],
  :edit-fields ["name"],
  :field-config {:name {:type "text", :label "Name"}}},
 :articles
 {:edit-fields
  ["manufacturer_id"
   "canonical_name"
   "unit"
   "subcategory_id"
   "link"
   "normalized_key"],
  :field-config
  {:unit {:type "select", :label "Unit", :default "kom", :options ["kom" "kg" "g" "l" "pak"]}
   :manufacturer_id
   {:type "select",
    :label "Manufacturer",
    :options ["manufacturers" "display_name"]},
   :subcategory_id
   {:type "select",
    :label "Subcategory",
    :options ["subcategories" "name"]}}},
 :expenses
 {:create-fields
  ["purchased_at"
   "supplier_id"
   "payer_id"
   "expense_category_id"
   "currency"
   "total_amount"
  "notes"],
  :edit-fields
  ["purchased_at"
   "supplier_id"
   "payer_id"
   "expense_category_id"
   "currency"
   "total_amount"
  "notes"],
  :batch-edit-fields
  ["purchased_at"
  "supplier_id"
  "payer_id"
  "expense_category_id"
  "currency"
  "total_amount"
  "notes"],
  :field-config
  {:purchased_at {:type "datetime-local"},
   :supplier_id
   {:type "select",
    :label "Supplier",
    :options ["suppliers" "display_name"]},
   :payer_id
   {:type "select", :label "Payer", :options ["payers" "label"]},
   :expense_category_id
   {:type "select",
    :label "Expense Category",
    :options ["expense-categories" "name"]},
   :currency
   {:type "select", :label "Currency", :options ["BAM" "EUR" "USD"]},
   :total_amount {:type "number", :step 0.01},
    :notes {:type "textarea"}}},
 :manufacturers
 {:create-fields ["display_name"],
  :edit-fields ["display_name"],
  :field-config {:display_name {:type "text", :label "Display name"}}},
 :categories
 {:create-fields ["name" "description"],
  :edit-fields ["name" "description"],
  :field-config
  {:name {:type "text", :label "Name"},
   :description {:type "textarea", :label "Description"}}},
 :supplier-aliases
 {:edit-fields ["raw_label" "raw_label_normalized" "supplier_id"],
  :field-config
  {:supplier_id
   {:type "select",
    :label "Supplier",
    :options ["suppliers" "display_name"]}}},
 :stores
 {:edit-fields ["display_name" "address"],
  :field-config
  {:display_name {:type "text", :label "Display name"},
   :address {:type "textarea", :label "Address"}}},
 :article-aliases
 {:edit-fields
  ["raw_label" "raw_label_normalized" "unit" "supplier_id" "article_id"],
  :field-config
  {:supplier_id
   {:type "select",
    :label "Supplier",
    :options ["suppliers" "display_name"]},
   :unit {:type "select", :label "Unit", :options ["kom" "kg" "g" "l" "pak"]},
   :article_id
   {:type "select",
    :label "Article",
    :options ["articles" "canonical_name"]}}},
 :store-aliases
 {:edit-fields
  ["raw_label" "raw_label_normalized" "store_id" "confidence"],
  :field-config
  {:raw_label {:type "text", :label "Raw label"},
   :raw_label_normalized {:type "text", :label "Alias"},
   :store_id
   {:type "select",
    :label "Store",
    :options ["stores" "display_name"]},
   :confidence {:type "number", :step 1}}},
 :expense-categories
 {:create-fields ["name" "exclude_from_reports" "is_default"],
  :edit-fields ["name" "exclude_from_reports" "is_default"],
  :field-config {:name {:type "text", :label "Name"},
                 :exclude_from_reports {:type "checkbox", :label "Exclude from reports"},
                 :is_default {:type "checkbox", :label "Default expense category"}}}}
